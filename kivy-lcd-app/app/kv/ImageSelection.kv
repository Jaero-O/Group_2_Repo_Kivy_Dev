#:kivy 2.0.0

<FilterButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: 13
    bold: True
    size_hint: None, None
    halign: "center"
    valign: "center"
    text_size: self.size

    canvas.before:
        # Outer shadow (visible only in normal state — gives lifted look)
        Color:
            rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.22)
        RoundedRectangle:
            pos: self.x + 1, self.y - 3
            size: self.size
            radius: [8]
        # Bottom edge / depth strip
        Color:
            rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
        RoundedRectangle:
            pos: self.x, self.y - 2
            size: self.size
            radius: [8]
        # Main button face — darker green when pressed
        Color:
            rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
        RoundedRectangle:
            pos: self.x, self.y + (2 if self.state == 'normal' else 0)
            size: self.size
            radius: [8]


<ImageSelection>:
    canvas.before:
        Color:
            rgba: 248/255, 248/255, 248/255, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # Records Header Icon
    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        height: 50
        width: self.parent.width
        pos_hint: {"x": 0.06, "y": 0.92}

        Image:
            source: "app/assets/records.png"
            size_hint: None, None
            size: 35, 35
            allow_stretch: True
            keep_ratio: True
            mipmap: True

    # Records Header Label
    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        height: 50
        width: self.parent.width
        pos_hint: {"x": 0.17, "y": 0.91}

        Label:
            text: "Records"
            color: 3/255, 30/255, 0/255, 1
            font_size: 32
            bold: True
            valign: "middle"
            halign: "left"
            text_size: self.size

    # Back Button
    RoundedButton:
        id: back_button
        size_hint: None, None
        size: 100, 36
        pos_hint: {"x": 0.79, "y": 0.915}
        on_press: app.root.current = 'records'

        BoxLayout:
            orientation: "horizontal"
            size: back_button.size
            pos: back_button.pos
            spacing: 6
            padding: [0, 0, 0, 0]
            pos_hint: {"center_y": 0.5}

            Image:
                source: "app/assets/back.png"
                allow_stretch: True
                keep_ratio: True
                size_hint: None, None
                size: 20, 20
                pos_hint: {"center_y": 0.5}
                mipmap: True

            Label:
                text: "Back"
                color: 3/255, 30/255, 0/255, 1
                font_size: 16
                bold: True
                size_hint_x: None
                width: self.texture_size[0]
                halign: "left"
                valign: "middle"
                pos_hint: {"center_y": 0.5}

    # Filter Buttons Row
    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        size: 420, 44
        pos_hint: {"center_x": 0.5, "top": 0.90}
        spacing: 8
        padding: [10, 0, 10, 0]

        # Disease filter button
        RelativeLayout:
            size_hint: None, None
            size: 110, 40

            FilterButton:
                id: disease_btn
                text: "Disease"
                size: 110, 40
                padding: [5, 0, 20, 0]
                on_press: root.show_disease_modal()

            Image:
                source: "app/assets/dropdown_white.png"
                size_hint: None, None
                size: 14, 14
                pos: 85, 13
                mipmap: True

        # Date filter button
        RelativeLayout:
            size_hint: None, None
            size: 110, 40

            FilterButton:
                id: date_btn
                text: "Date"
                size: 110, 40
                padding: [5, 0, 20, 0]
                on_press: root.show_date_modal()

            Image:
                source: "app/assets/dropdown_white.png"
                size_hint: None, None
                size: 14, 14
                pos: 85, 13
                mipmap: True

        # Sort button
        RelativeLayout:
            size_hint: None, None
            size: 110, 40

            FilterButton:
                id: sort_btn
                text: "Sort"
                size: 110, 40
                padding: [5, 0, 20, 0]
                on_press: root.show_sort_modal()

            Image:
                source: "app/assets/sort_white.png"
                size_hint: None, None
                size: 14, 14
                pos: 85, 13
                mipmap: True

        # Custom date range calendar button
        Button:
            id: calendar_btn
            size_hint: None, None
            size: 44, 40
            background_normal: ""
            background_color: 0, 0, 0, 0
            on_press: root.open_custom_date_picker()

            canvas.before:
                Color:
                    rgba: (0, 0, 0, 0.22) if self.state == 'normal' else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.x + 1, self.y - 3
                    size: self.size
                    radius: [8]
                Color:
                    rgba: (0/255, 100/255, 0/255, 1) if self.state == 'normal' else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.x, self.y - 2
                    size: self.size
                    radius: [8]
                Color:
                    rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
                    radius: [8]

            Image:
                source: "app/assets/filter_white.png"
                size_hint: None, None
                size: 22, 22
                center: self.parent.center
                mipmap: True

    # Image Gallery
    ScrollView:
        id: scroll_view
        size_hint: 1, None
        height: root.height * 0.78
        pos_hint: {"x": 0, "y": 0.04}
        on_scroll_y: root.on_scroll(args[1])

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: 2

            Label:
                text: 'No scans found' if len(root.displayed_images) == 0 else ''
                color: 3/255, 33/255, 0/255, 0.6
                size_hint_y: None
                height: 100 if len(root.displayed_images) == 0 else 0

            GridLayout:
                id: image_grid
                cols: 3
                spacing: [2, 2]
                size_hint_y: None
                height: self.minimum_height

            Button:
                text: "Load More"
                size_hint_y: None
                height: 44
                opacity: 1 if root.has_more else 0
                disabled: not root.has_more
                background_color: 0/255, 152/255, 0/255, 1
                on_press: root.load_more()
