#:kivy 2.0.0

# Record Item Layout
<RecordTreeItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: 49
    padding: [15, 0, 15, 0]

    canvas.before:
        Color:
            rgba: 232/255, 255/255, 208/255, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [11]
        Color:
            rgba: 0, 0, 0, 0.1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 11)
            width: 1


# Records Screen Layout
<RecordsScreen>
    canvas.before:
        Color:
            rgba: 248/255, 248/255, 248/255, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # Header Section
    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        height: 50
        width: self.parent.width
        pos_hint: {"x": 0.06, "y": 0.92}
        spacing: 5.3

        Image:
            source: "app/assets/records.png"
            size_hint: None, None
            size: 35, 35
            allow_stretch: True
            keep_ratio: True
            mipmap: True

    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        height: 50
        width: self.parent.width
        pos_hint: {"x": 0.17, "y": 0.91}
        spacing: 5.3

        Label:
            text: "Records"
            color: 3/255, 30/255, 0/255, 1
            font_size: 32
            bold: True
            valign: "middle"
            halign: "left"
            text_size: self.size

    # Back Button
    RoundedButton:
        id: back_button
        size_hint: None, None
        size: 100, 36
        pos_hint: {"x": 0.79, "y": 0.915}
        on_release: app.root.current = 'home'

        BoxLayout:
            orientation: "horizontal"
            size: self.size
            spacing: 6
            padding: [0, 0, 0, 0]
            pos_hint: {"center_y": 0.5}
            size: back_button.size
            pos: back_button.pos

            Image:
                source: "app/assets/back.png"
                allow_stretch: True
                keep_ratio: True
                size_hint: None, None
                size: 20, 20
                pos_hint: {"center_y": 0.5}
                mipmap: True

            Label:
                text: "Back"
                color: 3/255, 30/255, 0/255, 1
                font_size: 16
                bold: True
                size_hint_x: None
                width: self.texture_size[0]
                halign: "left"
                valign: "middle"
                pos_hint: {"center_y": 0.5}

    # Search Box
    BoxLayout:
        size_hint: None, None
        size: 400, 35
        pos_hint: {"center_x": 0.5, "top": 0.85}
        padding: [8, 0, 8, 0]
        spacing: 6

        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [15, 15, 15, 15]
            Color:
                rgba: 220/255, 220/255, 220/255, 1
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, 15)
                width: 1.1

        TextInput:
            id: search_input
            size_hint_x: 1
            multiline: False
            hint_text: "Search"
            hint_text_color: 166/255, 166/255, 166/255, 1
            foreground_color: 0, 0, 0, 1
            background_color: 0, 0, 0, 0
            padding: [12, (self.height - self.line_height)/2, 0, 0]
            font_size: 14
            cursor_color: 0, 0, 0, 1
            on_text: root.on_search_text(self.text)

        Image:
            source: "app/assets/search.png"
            size_hint: None, None
            size: 17, 17
            allow_stretch: True
            keep_ratio: True
            pos_hint: {"center_y": 0.5}

    # Action Buttons (Edit and Delete)
    BoxLayout:
        id: action_buttons
        orientation: "horizontal"
        size_hint: None, None
        size: 180, 40
        pos_hint: {"right": 0.917, "top": 0.785}
        spacing: 12
        opacity: 0
        disabled: True

        # Edit Button — green with 3-layer shadow
        Button:
            size_hint: None, None
            size: 80, 40
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: 16
            bold: True
            text: "Edit"
            on_press: root.on_edit_button()

            canvas.before:
                # Shadow
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.22)
                RoundedRectangle:
                    pos: self.x + 1, self.y - 3
                    size: self.size
                    radius: [8]
                # Bottom edge
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y - 2
                    size: self.size
                    radius: [8]
                # Main face
                Color:
                    rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
                    radius: [8]

        # Delete Button — red with 3-layer shadow
        Button:
            size_hint: None, None
            size: 88, 40
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: 16
            bold: True
            text: "Delete"
            on_press: root.on_delete_button()

            canvas.before:
                # Shadow
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.22)
                RoundedRectangle:
                    pos: self.x + 1, self.y - 3
                    size: self.size
                    radius: [8]
                # Bottom edge
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (160/255, 30/255, 45/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y - 2
                    size: self.size
                    radius: [8]
                # Main face
                Color:
                    rgba: (160/255, 30/255, 45/255, 1) if self.state == 'down' else (220/255, 53/255, 69/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
                    radius: [8]

    # Main Content Area
    FloatLayout:
        size_hint: None, None
        size: 400, 460
        pos_hint: {"center_x": 0.5, "y": 0.15}

        # Empty state label — shown when no trees or no search match
        Label:
            id: empty_label
            text: root.empty_message
            color: 160/255, 160/255, 160/255, 1
            font_size: 19
            bold: True
            halign: "center"
            valign: "top"
            size_hint: None, None
            size: 400, 80
            pos_hint: {"center_x": 0.5, "top": 0.92}
            text_size: self.width, None
            opacity: 1 if root.show_empty else 0

        # Scrollable Tree List
        ScrollView:
            id: scroll_view
            size_hint: None, None
            size: 400, 395
            pos_hint: {"center_x": 0.5, "top": 1}
            opacity: 0 if root.show_empty else 1
            bar_width: 6
            bar_color: 200/255, 200/255, 200/255, 1
            bar_inactive_color: 230/255, 230/255, 230/255, 0.5
            scroll_type: ['bars', 'content']
            effect_cls: "ScrollEffect"
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                id: tree_list
                orientation: "vertical"
                spacing: 12
                size_hint_y: None
                height: self.minimum_height
                padding: [4, 12, 4, 20]

    BoxLayout:
        orientation: "horizontal"
        size_hint: None, None
        size: 400, 49
        pos_hint: {"center_x": 0.5, "y": 0.040}
        spacing: 14

        # Add Tree Button — green 3-layer shadow + icon left of text
        Button:
            id: add_tree_button
            text: ""
            size_hint: None, None
            size: 193, 49
            font_size: 16
            bold: True
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            on_press: root.on_add_tree()

            canvas.before:
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.22)
                RoundedRectangle:
                    pos: self.x + 1, self.y - 3
                    size: self.size
                    radius: [11]
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y - 2
                    size: self.size
                    radius: [11]
                Color:
                    rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
                    radius: [11]

            BoxLayout:
                orientation: "horizontal"
                size: add_tree_button.size
                pos: add_tree_button.pos
                spacing: 8
                padding: [0, 0, 0, 0]

                Widget:
                    size_hint_x: 1

                Image:
                    source: "app/assets/add_tree_white.png"
                    size_hint: None, None
                    size: 22, 22
                    allow_stretch: True
                    keep_ratio: True
                    mipmap: True
                    pos_hint: {"center_y": 0.5}

                Label:
                    text: "Add Tree"
                    color: 1, 1, 1, 1
                    font_size: 16
                    bold: True
                    size_hint: None, None
                    size: 90, add_tree_button.height
                    halign: "left"
                    valign: "middle"
                    text_size: None, None

                Widget:
                    size_hint_x: 1

        # Export Button — red 3-layer shadow + icon left of text
        Button:
            id: export_button
            text: ""
            size_hint: None, None
            size: 193, 49
            font_size: 16
            bold: True
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            on_press: root.export_all_scans()

            canvas.before:
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.22)
                RoundedRectangle:
                    pos: self.x + 1, self.y - 3
                    size: self.size
                    radius: [11]
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (160/255, 30/255, 45/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y - 2
                    size: self.size
                    radius: [11]
                Color:
                    rgba: (160/255, 30/255, 45/255, 1) if self.state == 'down' else (220/255, 53/255, 69/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
                    radius: [11]

            BoxLayout:
                orientation: "horizontal"
                size: export_button.size
                pos: export_button.pos
                spacing: 8
                padding: [0, 0, 0, 0]

                Widget:
                    size_hint_x: 1

                Image:
                    source: "app/assets/export_white.png"
                    size_hint: None, None
                    size: 22, 22
                    allow_stretch: True
                    keep_ratio: True
                    mipmap: True
                    pos_hint: {"center_y": 0.5}

                Label:
                    text: "Export"
                    color: 1, 1, 1, 1
                    font_size: 16
                    bold: True
                    size_hint: None, None
                    size: 70, export_button.height
                    halign: "left"
                    valign: "middle"
                    text_size: None, None

                Widget:
                    size_hint_x: 1
