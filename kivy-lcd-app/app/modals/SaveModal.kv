#:kivy 2.0.0

<SaveModal>:
    size_hint: None, None
    size: 480, 800
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.7

    FloatLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.7
            Rectangle:
                pos: root.pos
                size: root.size

        # White rounded panel
        canvas:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: root.x + 24, root.center_y - (root.height * 0.68 / 2)
                size: root.width - 48, root.height * 0.68
                radius: [40, 40, 40, 40]
            Color:
                rgba: 0, 0, 0, 0.05
            Line:
                rounded_rectangle: (root.x + 24, root.center_y - (root.height * 0.68 / 2), root.width - 48, root.height * 0.68, 40)
                width: 1.3

        # Header icon
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.18, "top": 0.80}
            spacing: 6
            Image:
                source: "app/assets/save.png"
                size_hint: None, None
                size: 48, 48
                pos_hint: {"center_y": 0.5}
                allow_stretch: True
                keep_ratio: True
                mipmap: True

        # Header "Save" label
        Label:
            text: "Save"
            color: 3/255, 30/255, 0/255, 1
            font_size: 34
            bold: True
            valign: "middle"
            halign: "left"
            size_hint: None, None
            size: 120, 60
            pos_hint: {"x": 0.30, "top": 0.795}
            text_size: self.size

        Button:
            text: "Add Tree"
            size_hint: None, None
            size: 90, 38
            pos_hint: {"x": 0.6625, "top": 0.788}
            font_size: 14
            bold: True
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            on_press: root.on_add_tree()
            canvas.before:
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.22)
                RoundedRectangle:
                    pos: self.x + 1, self.y - 3
                    size: self.size
                    radius: [10]
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y - 2
                    size: self.size
                    radius: [10]
                Color:
                    rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                RoundedRectangle:
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
                    radius: [10]

        # Error label — above divider with small gap, same style as AddTreeModal
        Label:
            id: error_label
            text: ""
            color: 220/255, 53/255, 69/255, 1
            font_size: 13
            bold: True
            size_hint: None, None
            size: root.width * 0.7, 22
            pos_hint: {"center_x": 0.5, "top": 0.72}
            halign: "center"
            valign: "middle"
            text_size: self.size
            opacity: 0

        # Divider — 70% width centered
        FloatLayout:
            size_hint: 1, 1
            canvas:
                Color:
                    rgba: 0, 0, 0, 0.15
                Rectangle:
                    size: self.width * 0.7, 1.5
                    pos: self.width * 0.15, self.height * 0.68

        # Search box — BoxLayout so TextInput respects bounds
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: root.width * 0.7, 42
            pos_hint: {"center_x": 0.5, "top": 0.65}
            padding: [14, 0, 10, 0]
            spacing: 0

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8]
                Color:
                    rgba: 220/255, 220/255, 220/255, 1
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                    width: 1.1

            TextInput:
                id: search_input
                size_hint_x: 1
                size_hint_y: None
                height: 42
                multiline: False
                hint_text: "Search trees..."
                hint_text_color: 140/255, 140/255, 140/255, 1
                foreground_color: 3/255, 30/255, 0/255, 1
                background_color: 0, 0, 0, 0
                padding: [0, (self.height - self.line_height) / 2, 0, 0]
                font_size: 14
                cursor_color: 3/255, 30/255, 0/255, 1
                selection_color: 0.7, 0.9, 0.7, 0.5
                on_text: root.on_search_text(self.text)

            Image:
                source: "app/assets/search.png"
                size_hint: None, None
                size: 18, 18
                allow_stretch: True
                keep_ratio: True
                mipmap: True
                pos_hint: {"center_y": 0.5}

        # Empty state label
        Label:
            id: empty_label
            text: root.empty_message
            color: 160/255, 160/255, 160/255, 1
            font_size: 14
            bold: True
            halign: "center"
            valign: "top"
            size_hint: None, None
            width: root.width * 0.7
            height: 60
            pos_hint: {"center_x": 0.5, "top": 0.55}
            text_size: self.width, None
            opacity: 1 if root.show_empty else 0

        # Tree scroll list
        ScrollView:
            id: scroll_view
            size_hint: None, None
            size: root.width * 0.7, 220
            pos_hint: {"center_x": 0.5, "top": 0.575}
            bar_width: 6
            bar_color: 200/255, 200/255, 200/255, 1
            bar_inactive_color: 230/255, 230/255, 230/255, 0.5
            scroll_type: ['bars', 'content']
            effect_cls: "ScrollEffect"
            do_scroll_x: False
            do_scroll_y: True
            opacity: 0 if root.show_empty else 1

            BoxLayout:
                id: tree_list
                orientation: "vertical"
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        # Action buttons
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 260, 44
            pos_hint: {"center_x": 0.5, "y": 0.22}
            spacing: 30

            # Cancel Button
            Button:
                text: "Cancel"
                size_hint: None, None
                size: 115, 44
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: (0/255, 36/255, 0/255, 1) if self.state == 'down' else (0/255, 56/255, 0/255, 1)
                font_size: 16
                bold: True
                on_press: root.dismiss()
                canvas.before:
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.15)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x + 1, self.y - 3
                        size: self.size
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (180/255, 180/255, 180/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y - 2
                        size: self.size
                    Color:
                        rgba: (220/255, 220/255, 220/255, 1) if self.state == 'down' else (241/255, 241/255, 241/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                        size: self.size

            # Save Button
            Button:
                text: "Save"
                size_hint: None, None
                size: 115, 44
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                font_size: 16
                bold: True
                on_press: root.on_save_button()
                canvas.before:
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.2)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x + 1, self.y - 3
                        size: self.size
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y - 2
                        size: self.size
                    Color:
                        rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                        size: self.size
