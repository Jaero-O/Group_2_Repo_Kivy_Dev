#:kivy 2.0

<FilterOption@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.85, 0.85, 0.85, 1) if self.state == 'down' else (237/255, 237/255, 237/255, 1)
    color: (3/255, 33/255, 0/255, 1)
    font_size: 15
    bold: True
    size_hint_y: None
    height: 40

<CustomFilterModal>:
    size_hint: None, None
    size: 480, 800
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.7

    FloatLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.7
            Rectangle:
                pos: root.pos
                size: root.size

        # White rounded card
        canvas:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: root.x + 24, root.center_y - (root.height * 0.70 / 2)
                size: root.width - 48, root.height * 0.70
                radius: [40, 40, 40, 40]
            Color:
                rgba: 0, 0, 0, 0.05
            Line:
                rounded_rectangle: (root.x + 24, root.center_y - (root.height * 0.70 / 2), root.width - 48, root.height * 0.70, 40)
                width: 1.3

        # Header icon
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.18, "top": 0.800}
            spacing: 6
            Image:
                source: "app/assets/filter_green.png"
                size_hint: None, None
                size: 48, 48
                pos_hint: {"center_y": 0.5}
                allow_stretch: True
                keep_ratio: True
                mipmap: True

        # Header label
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.30, "top": 0.795}
            Label:
                text: "Custom Filter"
                color: 3/255, 30/255, 0/255, 1
                font_size: 34
                bold: True
                valign: "middle"
                halign: "left"
                text_size: self.size

        # Divider
        FloatLayout:
            size_hint: 1, 1
            canvas:
                Color:
                    rgba: 0, 0, 0, 0.15
                Rectangle:
                    size: self.width * 0.7, 1.5
                    pos: self.width * 0.15, self.height * 0.700

        # ── Content area ──────────────────────────────────────────────
        BoxLayout:
            orientation: "vertical"
            size_hint: None, None
            size: root.width * 0.7, 310
            pos_hint: {"center_x": 0.5, "center_y": 0.52}
            spacing: 10
            padding: [0, 0, 0, 0]

            # ── Quick Filter ──────────────────────────────────────────
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 84
                spacing: 12

                Label:
                    text: "Quick Filter"
                    color: 3/255, 30/255, 0/255, 1
                    font_size: 20
                    bold: True
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size
                    size_hint_y: None
                    height: 26

                Button:
                    id: quick_filter_btn
                    text: root.selected_quick_filter
                    size_hint_y: None
                    height: 52
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    color: 3/255, 30/255, 0/255, 1
                    font_size: 15
                    bold: True
                    halign: "left"
                    valign: "center"
                    text_size: self.width - 28, self.height
                    padding: [14, 0, 14, 0]
                    on_press: root.show_quick_filter_dropdown()
                    canvas.before:
                        Color:
                            rgba: (0/255, 152/255, 0/255, 1) if root.quick_filter_open else (226/255, 226/255, 226/255, 1)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                            width: 2
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.x + 1, self.y + 1
                            size: self.width - 2, self.height - 2
                            radius: [9, 9, 9, 9]

            # ── Custom Range ──────────────────────────────────────────
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 172
                spacing: 14

                Label:
                    text: "Custom Range"
                    color: 3/255, 30/255, 0/255, 1
                    font_size: 20
                    bold: True
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size
                    size_hint_y: None
                    height: 26

                # From row
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 52
                    spacing: 8

                    Label:
                        text: "From:"
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_x: None
                        width: 50

                    Button:
                        id: start_month_btn
                        text: root.start_month_text
                        size_hint_x: 0.33
                        background_normal: ""
                        background_color: 0, 0, 0, 0
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "center"
                        valign: "center"
                        text_size: self.size
                        on_press: root.show_month_dropdown('start')
                        canvas.before:
                            Color:
                                rgba: (0/255, 152/255, 0/255, 1) if root.start_month_open else (226/255, 226/255, 226/255, 1)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                                width: 2
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.x + 1, self.y + 1
                                size: self.width - 2, self.height - 2
                                radius: [7, 7, 7, 7]

                    Button:
                        id: start_day_btn
                        text: root.start_day_text
                        size_hint_x: 0.33
                        background_normal: ""
                        background_color: 0, 0, 0, 0
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "center"
                        valign: "center"
                        text_size: self.size
                        on_press: root.show_day_dropdown('start')
                        canvas.before:
                            Color:
                                rgba: (0/255, 152/255, 0/255, 1) if root.start_day_open else (226/255, 226/255, 226/255, 1)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                                width: 2
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.x + 1, self.y + 1
                                size: self.width - 2, self.height - 2
                                radius: [7, 7, 7, 7]

                    Button:
                        id: start_year_btn
                        text: root.start_year_text
                        size_hint_x: 0.34
                        background_normal: ""
                        background_color: 0, 0, 0, 0
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "center"
                        valign: "center"
                        text_size: self.size
                        on_press: root.show_year_dropdown('start')
                        canvas.before:
                            Color:
                                rgba: (0/255, 152/255, 0/255, 1) if root.start_year_open else (226/255, 226/255, 226/255, 1)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                                width: 2
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.x + 1, self.y + 1
                                size: self.width - 2, self.height - 2
                                radius: [7, 7, 7, 7]

                # To row
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 52
                    spacing: 8

                    Label:
                        text: "To:"
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_x: None
                        width: 50

                    Button:
                        id: end_month_btn
                        text: root.end_month_text
                        size_hint_x: 0.33
                        background_normal: ""
                        background_color: 0, 0, 0, 0
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "center"
                        valign: "center"
                        text_size: self.size
                        on_press: root.show_month_dropdown('end')
                        canvas.before:
                            Color:
                                rgba: (0/255, 152/255, 0/255, 1) if root.end_month_open else (226/255, 226/255, 226/255, 1)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                                width: 2
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.x + 1, self.y + 1
                                size: self.width - 2, self.height - 2
                                radius: [7, 7, 7, 7]

                    Button:
                        id: end_day_btn
                        text: root.end_day_text
                        size_hint_x: 0.33
                        background_normal: ""
                        background_color: 0, 0, 0, 0
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "center"
                        valign: "center"
                        text_size: self.size
                        on_press: root.show_day_dropdown('end')
                        canvas.before:
                            Color:
                                rgba: (0/255, 152/255, 0/255, 1) if root.end_day_open else (226/255, 226/255, 226/255, 1)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                                width: 2
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.x + 1, self.y + 1
                                size: self.width - 2, self.height - 2
                                radius: [7, 7, 7, 7]

                    Button:
                        id: end_year_btn
                        text: root.end_year_text
                        size_hint_x: 0.34
                        background_normal: ""
                        background_color: 0, 0, 0, 0
                        color: 3/255, 30/255, 0/255, 1
                        font_size: 15
                        bold: True
                        halign: "center"
                        valign: "center"
                        text_size: self.size
                        on_press: root.show_year_dropdown('end')
                        canvas.before:
                            Color:
                                rgba: (0/255, 152/255, 0/255, 1) if root.end_year_open else (226/255, 226/255, 226/255, 1)
                            Line:
                                rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                                width: 2
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.x + 1, self.y + 1
                                size: self.width - 2, self.height - 2
                                radius: [7, 7, 7, 7]

        # ── Action buttons ─────────────────────────────────────────────
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 260, 44
            pos_hint: {"center_x": 0.5, "y": 0.220}
            spacing: 30

            # Cancel — matches Delete Modal cancel style
            Button:
                text: "Cancel"
                size_hint: None, None
                size: 115, 44
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: (0/255, 36/255, 0/255, 1) if self.state == 'down' else (0/255, 56/255, 0/255, 1)
                font_size: 16
                bold: True
                on_press: root.dismiss()
                canvas.before:
                    # Shadow
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.15)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x + 1, self.y - 3
                        size: self.size
                    # Bottom edge
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (180/255, 180/255, 180/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y - 2
                        size: self.size
                    # Main face
                    Color:
                        rgba: (220/255, 220/255, 220/255, 1) if self.state == 'down' else (241/255, 241/255, 241/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                        size: self.size

            # Apply — green with 3-layer shadow
            Button:
                text: "Apply"
                size_hint: None, None
                size: 115, 44
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                font_size: 16
                bold: True
                on_press: root._apply_custom(self)
                canvas.before:
                    # Shadow
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.2)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x + 1, self.y - 3
                        size: self.size
                    # Bottom edge
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y - 2
                        size: self.size
                    # Main face
                    Color:
                        rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                        size: self.size
