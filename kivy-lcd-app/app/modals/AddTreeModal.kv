#:kivy 2.0
#Updated
<AddTreeModal>:
    size_hint: None, None
    size: 480, 800
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.7
    
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.7
            Rectangle:
                pos: root.pos
                size: root.size
        
        canvas:
            Color:  
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                id: inner_panel
                pos: root.x + 24, root.center_y - (root.height * 0.68 / 2)
                size: root.width - 48, root.height * 0.68
                radius: [40, 40, 40, 40]
            Color:
                rgba: 0, 0, 0, 0.05
            Line:
                rounded_rectangle: (root.x + 24, root.center_y - (root.height * 0.68 / 2), root.width - 48, root.height * 0.68, 40)
                width: 1.3
        
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.18, "top": 0.80}
            spacing: 6
            
            Image:
                source: "app/assets/add_tree_green.png"
                size_hint: None, None
                size: 48, 48
                pos_hint: {"center_y": 0.5}
                allow_stretch: True
                keep_ratio: True
                mipmap: True
        
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.30, "top": 0.795}
            spacing: 5
            
            Label:
                text: "Add Tree"
                color: 3/255, 30/255, 0/255, 1
                font_size: 34
                bold: True
                valign: "middle"
                halign: "left"
                text_size: self.size
        
        FloatLayout:
            size_hint: 1, 1
            canvas:
                Color:
                    rgba: 0, 0, 0, 0.15
                Rectangle:
                    size: self.width * 0.7, 1.5
                    pos: self.width * 0.15, self.height * 0.68
        
        Label:
            id: error_label
            text: ""
            color: 220/255, 53/255, 69/255, 1
            font_size: 13
            bold: True
            size_hint: None, None
            size: root.width * 0.7, 25
            pos_hint: {"center_x": 0.5, "top": 0.66}
            halign: "center"
            valign: "middle"
            text_size: self.size
            opacity: 0
        
        BoxLayout:
            orientation: "vertical"
            size_hint: None, None
            size: root.width * 0.7, 280
            pos_hint: {"center_x": 0.5, "center_y": 0.47}
            spacing: 15
            padding: [0, 0, 0, 0]
            
            # Name field
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 68
                spacing: 6
                
                Label:
                    text: "Name*"
                    color: 3/255, 30/255, 0/255, 1
                    font_size: 16
                    bold: True
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size
                    size_hint_y: None
                    height: 20
                
                TextInput:
                    id: name_input
                    hint_text: "Enter tree name (required)"
                    hint_text_color: 140/255, 140/255, 140/255, 1
                    foreground_color: 3/255, 30/255, 0/255, 1
                    font_size: 14
                    multiline: False
                    size_hint_y: None
                    height: 42
                    padding: [14, 12, 14, 12]
                    background_normal: ""
                    background_color: 1, 1, 1, 1
                    cursor_color: 3/255, 30/255, 0/255, 1
                    selection_color: 0.7, 0.9, 0.7, 0.5
                    canvas.before:
                        Color:
                            rgba: (0/255, 152/255, 0/255, 1) if self.focus else (220/255, 220/255, 220/255, 1)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                            width: 2 if self.focus else 1.1
            
            # Location field
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 68
                spacing: 6
                
                Label:
                    text: "Location"
                    color: 3/255, 30/255, 0/255, 1
                    font_size: 16
                    bold: True
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size
                    size_hint_y: None
                    height: 20
                
                TextInput:
                    id: location_input
                    hint_text: "e.g., North Field, Row 3"
                    hint_text_color: 140/255, 140/255, 140/255, 1
                    foreground_color: 3/255, 30/255, 0/255, 1
                    font_size: 14
                    multiline: False
                    size_hint_y: None
                    height: 42
                    padding: [14, 12, 14, 12]
                    background_normal: ""
                    background_color: 1, 1, 1, 1
                    cursor_color: 3/255, 30/255, 0/255, 1
                    selection_color: 0.7, 0.9, 0.7, 0.5
                    canvas.before:
                        Color:
                            rgba: (0/255, 152/255, 0/255, 1) if self.focus else (220/255, 220/255, 220/255, 1)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                            width: 2 if self.focus else 1.1
            
            # Variety field
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: 68
                spacing: 6
                
                Label:
                    text: "Variety"
                    color: 3/255, 30/255, 0/255, 1
                    font_size: 16
                    bold: True
                    halign: "left"
                    valign: "bottom"
                    text_size: self.size
                    size_hint_y: None
                    height: 20
                
                TextInput:
                    id: variety_input
                    hint_text: "e.g., Carabao, Kent, Alphonso"
                    hint_text_color: 140/255, 140/255, 140/255, 1
                    foreground_color: 3/255, 30/255, 0/255, 1
                    font_size: 14
                    multiline: False
                    size_hint_y: None
                    height: 42
                    padding: [14, 12, 14, 12]
                    background_normal: ""
                    background_color: 1, 1, 1, 1
                    cursor_color: 3/255, 30/255, 0/255, 1
                    selection_color: 0.7, 0.9, 0.7, 0.5
                    canvas.before:
                        Color:
                            rgba: (0/255, 152/255, 0/255, 1) if self.focus else (220/255, 220/255, 220/255, 1)
                        Line:
                            rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                            width: 2 if self.focus else 1.1
            
            Label:
                text: "* Required field\nName must be unique"
                color: 99/255, 99/255, 99/255, 1
                font_size: 11
                halign: "center"
                valign: "middle"
                text_size: self.size
                size_hint_y: None
                height: 34
        
        # Action buttons
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 260, 44
            pos_hint: {"center_x": 0.5, "y": 0.23}
            spacing: 30
            
            # Cancel Button — matches Delete Modal cancel style
            Button:
                text: "Cancel"
                size_hint: None, None
                size: 115, 44
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: (0/255, 36/255, 0/255, 1) if self.state == 'down' else (0/255, 56/255, 0/255, 1)
                font_size: 16
                bold: True
                on_release: root.cancel()
                canvas.before:
                    # Shadow
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.15)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x + 1, self.y - 3
                        size: self.size
                    # Bottom edge
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (180/255, 180/255, 180/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y - 2
                        size: self.size
                    # Main face
                    Color:
                        rgba: (220/255, 220/255, 220/255, 1) if self.state == 'down' else (241/255, 241/255, 241/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                        size: self.size
            
            # Add Tree Button — green with 3-layer shadow
            Button:
                text: "Add Tree"
                size_hint: None, None
                size: 115, 44
                background_normal: ""
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                font_size: 16
                bold: True
                on_release: root.add_tree()
                canvas.before:
                    # Shadow
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.2)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x + 1, self.y - 3
                        size: self.size
                    # Bottom edge
                    Color:
                        rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y - 2
                        size: self.size
                    # Main face
                    Color:
                        rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                    RoundedRectangle:
                        radius: [8]
                        pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                        size: self.size
