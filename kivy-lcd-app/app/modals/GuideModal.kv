#:kivy 2.0.0

<GuideModal>:
    size_hint: None, None
    size: 480, 800
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.7

    FloatLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.7
            Rectangle:
                pos: root.pos
                size: root.size

        # White rounded panel — same as SaveModal / AddTreeModal
        canvas:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: root.x + 24, root.center_y - (root.height * 0.68 / 2)
                size: root.width - 48, root.height * 0.68
                radius: [40, 40, 40, 40]
            Color:
                rgba: 0, 0, 0, 0.05
            Line:
                rounded_rectangle: (root.x + 24, root.center_y - (root.height * 0.68 / 2), root.width - 48, root.height * 0.68, 40)
                width: 1.3

        # Header icon
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.18, "top": 0.80}
            spacing: 6
            Image:
                source: "app/assets/guide.png"
                size_hint: None, None
                size: 48, 48
                pos_hint: {"center_y": 0.5}
                allow_stretch: True
                keep_ratio: True
                mipmap: True

        # Header label
        BoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: 480, 60
            pos_hint: {"x": 0.30, "top": 0.795}
            spacing: 5
            Label:
                text: "Guide"
                color: 3/255, 30/255, 0/255, 1
                font_size: 34
                bold: True
                valign: "middle"
                halign: "left"
                text_size: self.size

        # Divider line
        FloatLayout:
            size_hint: 1, 1
            canvas:
                Color:
                    rgba: 0, 0, 0, 0.15
                Rectangle:
                    size: self.width * 0.7, 1.5
                    pos: self.width * 0.15, self.height * 0.68

        # Instruction text — original GuideScreen content
        Label:
            text: "Before scanning, make sure the entire mango leaf is fully visible within the camera or scanner frame. Ensure no part of the leaf is cut off or out of view for accurate scanning results."
            color: 65/255, 65/255, 65/255, 1
            font_size: 29
            halign: "left"
            valign: "top"
            pos_hint: {"center_x": 0.5, "top": 0.64}
            text_size: self.width - 70, None
            size_hint: 0.85, None
            height: self.texture_size[1]

        # Back button — original position (center_x: 0.25, y: 0.05)
        Button:
            text: "Back"
            size_hint: None, None
            size: 115, 44
            pos_hint: {"center_x": 0.25, "y": 0.05}
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: (0/255, 36/255, 0/255, 1) if self.state == 'down' else (0/255, 56/255, 0/255, 1)
            font_size: 16
            bold: True
            on_press: root.dismiss()
            canvas.before:
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.15)
                RoundedRectangle:
                    radius: [8]
                    pos: self.x + 1, self.y - 3
                    size: self.size
                Color:
                    rgba: (0, 0, 0, 0) if self.state == 'down' else (180/255, 180/255, 180/255, 1)
                RoundedRectangle:
                    radius: [8]
                    pos: self.x, self.y - 2
                    size: self.size
                Color:
                    rgba: (220/255, 220/255, 220/255, 1) if self.state == 'down' else (241/255, 241/255, 241/255, 1)
                RoundedRectangle:
                    radius: [8]
                    pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                    size: self.size
