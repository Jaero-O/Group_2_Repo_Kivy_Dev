#:kivy 2.0.0

<SaveSuccessModal>:
    size_hint: None, None
    size: 480, 800
    auto_dismiss: False
    background: ""
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.5

    FloatLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.5
            Rectangle:
                pos: root.pos
                size: root.size

        # White modal box — same style as Delete/Edit modal
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: 300, 185
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            padding: [18, 18, 18, 18]
            spacing: 12

            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.25
                RoundedRectangle:
                    radius: [16]
                    pos: self.x + 2, self.y - 4
                    size: self.size
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    radius: [16]
                    pos: self.pos
                    size: self.size

            # Title
            Label:
                text: "Leaf Saved!"
                color: 3/255, 33/255, 0/255, 1
                font_size: 20
                bold: True
                size_hint_y: None
                height: 26
                halign: "center"
                valign: "middle"
                text_size: self.size

            # Message
            Label:
                text: root.message
                color: 49/255, 49/255, 49/255, 1
                font_size: 14
                size_hint_y: None
                height: 40
                halign: "center"
                valign: "middle"
                text_size: self.size

            # Buttons
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: 34
                spacing: 8

                # Scan Again — same style as Cancel buttons across all modals
                Button:
                    text: "Scan Again"
                    size_hint_x: 0.5
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    color: (0/255, 36/255, 0/255, 1) if self.state == 'down' else (0/255, 56/255, 0/255, 1)
                    font_size: 14
                    bold: True
                    on_press: root.go_scan()
                    canvas.before:
                        Color:
                            rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.15)
                        RoundedRectangle:
                            radius: [7]
                            pos: self.x + 1, self.y - 3
                            size: self.size
                        Color:
                            rgba: (0, 0, 0, 0) if self.state == 'down' else (180/255, 180/255, 180/255, 1)
                        RoundedRectangle:
                            radius: [7]
                            pos: self.x, self.y - 2
                            size: self.size
                        Color:
                            rgba: (220/255, 220/255, 220/255, 1) if self.state == 'down' else (241/255, 241/255, 241/255, 1)
                        RoundedRectangle:
                            radius: [7]
                            pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                            size: self.size

                # Home — green with 3-layer shadow
                Button:
                    text: "Home"
                    size_hint_x: 0.5
                    background_normal: ""
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    font_size: 14
                    bold: True
                    on_press: root.go_home()
                    canvas.before:
                        Color:
                            rgba: (0, 0, 0, 0) if self.state == 'down' else (0, 0, 0, 0.2)
                        RoundedRectangle:
                            radius: [7]
                            pos: self.x + 1, self.y - 3
                            size: self.size
                        Color:
                            rgba: (0, 0, 0, 0) if self.state == 'down' else (0/255, 100/255, 0/255, 1)
                        RoundedRectangle:
                            radius: [7]
                            pos: self.x, self.y - 2
                            size: self.size
                        Color:
                            rgba: (0/255, 110/255, 0/255, 1) if self.state == 'down' else (0/255, 152/255, 0/255, 1)
                        RoundedRectangle:
                            radius: [7]
                            pos: self.x, self.y + (2 if self.state == 'normal' else 0)
                            size: self.size
